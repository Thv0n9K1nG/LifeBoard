# =============================================================
#  LifeBoard — Root .gitignore
#  Covers: Tauri 2 · Rust · React (Vite) · SQLite
# =============================================================

# ── Environment & Local Config ─────────────────────────────────
.env
.env.local
.env.*.local
.env.production
*.secret
secrets/

# ── Node.js / Frontend ────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
.yarn/

# Frontend build outputs
lifeboard-client/dist/
lifeboard-client/dist-ssr/
lifeboard-client/.vite/

# ── Rust & Tauri Desktop ──────────────────────────────────────
src-tauri/target/
**/target/
**/*.rs.bk
Cargo.lock

# ── SQLite & Local Data ───────────────────────────────────────
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ── IDE & Editors ─────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

.idea/
*.iml

# ── OS & System ───────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.lnk

# ── Logs & Temp ───────────────────────────────────────────────
*.log
*.bak
*.tmp
*.temp
.cache/
