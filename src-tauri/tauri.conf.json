{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LifeBoard",
  "version": "0.6.0",
  "identifier": "com.lifeboard.app",
  "build": {
    "frontendDist": "../lifeboard-client/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix lifeboard-client run dev",
    "beforeBuildCommand": "npm --prefix lifeboard-client run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LifeBoard — Personal Productivity System",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
